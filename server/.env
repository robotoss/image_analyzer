# ===============================
# Database connection settings
# ===============================

# Hostname of the PostgreSQL database (matches service name in docker-compose)
DB_HOST=postgres
# Database username (must match POSTGRES_USER in postgres service)
DB_USER=myuser
# Database password (must match POSTGRES_PASSWORD in postgres service)
DB_PASSWORD=mypassword
# Database name (must match POSTGRES_DB in postgres service)
DB_NAME=mydb

# ===============================
# Ollama AI service settings
# ===============================

# URL of the Ollama service (internal Docker network address)
OLLAMA_HOST=http://ollama:11434

# ===============================
# Server settings
# ===============================

# Port the Node.js server will listen on inside the container
PORT=3002

# Model name to use with Ollama
OLLAMA_MODEL=llava
